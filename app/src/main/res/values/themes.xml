<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.GSB" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/electric_blue</item>
        <item name="colorPrimaryVariant">@color/electric_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/electric_blue_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background_white</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="materialButtonStyle">@style/Widget.GSB.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.GSB.Button.Outlined</item>
    </style>

    <style name="Theme.GSB" parent="Base.Theme.GSB" />

    <style name="Widget.GSB.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/electric_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.GSB.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/electric_blue</item>
        <item name="android:textColor">@color/electric_blue</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
